# Brevo transactional email. Keep the API key server-only.
BREVO_API_KEY=xkeysib-replace_me
ORDER_EMAIL_FROM=orders@example.com
ORDER_EMAIL_FROM_NAME=FoodApp

# Public HTTPS origin used in secure order-tracking links.
APP_BASE_URL=https://orders.example.com

# Generate independent random values of at least 32 bytes.
EMAIL_WORKER_SECRET=replace_with_a_long_random_secret
BREVO_WEBHOOK_TOKEN=replace_with_a_different_long_random_secret
