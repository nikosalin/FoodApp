# Sandbox by default. Never prefix credentials with NEXT_PUBLIC_.
WOLT_MODE=sandbox
WOLT_CLIENT_ID=
WOLT_CLIENT_SECRET=
WOLT_VENUE_ID=

UBER_EATS_MODE=sandbox
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_STORE_ID=

JET_CONNECT_MODE=sandbox
JET_CONNECT_API_KEY=
JET_CONNECT_RESTAURANT_ID=
# A random bearer token supplied to JET Connect for inbound callbacks.
JET_CONNECT_WEBHOOK_TOKEN=
