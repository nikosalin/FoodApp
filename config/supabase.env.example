# Local values are printed by: npm run supabase:status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key

# Server-only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=replace_with_local_secret_key
